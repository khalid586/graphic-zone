# API_KEY: Required for API calls.
# Configure this with your API key.
API_KEY="YOUR_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# RESEND_API_KEY: API key for Resend email service
# Get your free API key from https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000 emails/month
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# Turso Database Configuration
# Get your credentials from https://turso.tech
# 1. Create a Turso account
# 2. Create a new database
# 3. Get the connection URL and auth token
TURSO_CONNECTION_URL="libsql://YOUR_DATABASE_NAME-YOUR_ORGANIZATION.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"
